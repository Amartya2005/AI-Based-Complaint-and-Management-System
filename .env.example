# =============================================================================
# CCMS Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env (it is gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# Use pymysql driver for SQLAlchemy.
# When using docker-compose.dev.yml the host is localhost (published port).
# Example with special chars in password: use URL encoding for @ etc.
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://root:amartya%402005@127.0.0.1:3306/ComplaintManagement

# -----------------------------------------------------------------------------
# JWT / Auth
# IMPORTANT: Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. The app will refuse weak/default values on startup.
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Redis (for caching + JWT token blacklist/revocation)
# With docker-compose.dev.yml this becomes available at localhost:6379
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=300
REDIS_JWT_BLACKLIST_TTL=3600

# -----------------------------------------------------------------------------
# Rate Limiting (slowapi)
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_COMPLAINT_CREATE=20/minute

# -----------------------------------------------------------------------------
# Email / SMTP (optional but recommended for real notifications)
# If NOTIFICATIONS_ENABLED=true but creds missing, emails are skipped gracefully
# (in-app notifications still work). Use EMAIL_ENABLED to fully disable email attempts.
#
# For Gmail: Use an "App Password" (not your regular account password).
#   1. Enable 2FA on the Google account.
#   2. Go to https://myaccount.google.com/apppasswords -> generate for "Mail".
#   3. Use the 16-char app password as SMTP_PASSWORD.
# SMTP uses STARTTLS on 587 (not SMTPS/465).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_NAME=Complaint Management System
SMTP_FROM_EMAIL=noreply@yourdomain.com
NOTIFICATIONS_ENABLED=true
EMAIL_ENABLED=true

# -----------------------------------------------------------------------------
# ML / Classification
# Currently falls back to rule-based keyword classifier if model missing.
# -----------------------------------------------------------------------------
ML_MODEL_PATH=app/ml/models/classifier.joblib
ML_MIN_TRAINING_SAMPLES=50
ML_CONFIDENCE_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
DEBUG=false

# -----------------------------------------------------------------------------
# File uploads for attachments
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
# Max upload size handled in code (5MB), allowed: pdf,png,jpg,jpeg,docx,txt


# -----------------------------------------------------------------------------
# CORS (comma or list handled by pydantic)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Production notes (used with docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# 1. Copy this file to .env and NEVER commit the real .env
# 2. Set strong SECRET_KEY (the app validates >=32 chars)
# 3. For prod compose, change hosts to internal container names:
#    DATABASE_URL=mysql+pymysql://root:YOUR_STRONG_PASS@mysql:3306/ComplaintManagement
#    REDIS_URL=redis://redis:6379/0
#    ALLOWED_ORIGINS=https://your-production-domain.com   (NO wildcard * allowed in prod - see lifespan guard)
# 4. APP_ENV=production
#    DEBUG=false
# 5. Rate limiting values above are active (via slowapi).
# 6. Mounts for uploads/ and app/ml/models/ are handled by compose (./data/* on host).
# 7. After changing .env for prod: docker compose -f docker-compose.prod.yml up --build -d
